# Python缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# 运行数据（不入版本库）
acg_crawler/data/*.db
acg_crawler/data/*.db-wal
acg_crawler/data/*.db-shm
acg_crawler/images/
acg_crawler/output/

# 数据库备份与运行日志（体积大：backups/ 约 558MB，单文件超 GitHub 100MB 上限）
acg_crawler/data/backups/
acg_crawler/data/*.bak*
acg_crawler/data/*.pre-multi
acg_crawler/logs/

# 数据库快照（12MB/份，由 tools/snapshot_db.py 生成，只存本地双盘 C: 和 D:）
# 不进 git 的原因：会撑爆仓库；它的价值在于本地磁盘冗余，不是版本历史
acg_crawler/data/_safe_backup/*.dbbak
acg_crawler/data/.snap-tmp.dbbak

# Agent / 工具本地目录
.workbuddy-ai/
.freebuff/
.ohmyagent/
.git_broken/

# 敏感配置
acg_crawler/.env
*.env

# 日志与临时文件
*.log
终端完整内容.txt
.workbuddy/

# 本地解压导出目录
PC下载 (1)/
PC+安卓下载 (1)/

# 系统文件
.DS_Store
Thumbs.db
nul

# 一次性调试脚本（清出来过，别再堆在根目录）
_patch*.py
_probe*.py
_dbg*.py
_diag*.py
_fixapp.py
_peek.py
_del_nul.py
